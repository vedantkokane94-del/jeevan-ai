{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "outputDirectory": ".next",
  "regions": ["sin1", "blr1", "iad1"],
  "env": {
    "NEXT_PUBLIC_API_URL": "@jeevan_api_url",
    "NEXT_PUBLIC_WS_URL": "@jeevan_ws_url"
  },
  "builds": [
    {
      "src": "apps/web/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/web/$1"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "${NEXT_PUBLIC_API_URL}/$1"
    }
  ]
}
