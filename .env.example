# =============================================================================
# JEEVAN AI — Environment Variables (SRS §21.3)
# =============================================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env to source control.
# =============================================================================

# --- Database (PostgreSQL + PostGIS) ---
DATABASE_URL=postgresql+asyncpg://jeevan:jeevan_dev@localhost:5432/jeevan_ai
DATABASE_URL_SYNC=postgresql://jeevan:jeevan_dev@localhost:5432/jeevan_ai

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Authentication ---
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# --- Map ---
MAP_API_KEY=

# --- AI Services ---
AI_SERVICE_URL=http://localhost:8001

# --- Storage ---
STORAGE_BUCKET=

# --- SMTP (optional, only if email notifications configured) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
